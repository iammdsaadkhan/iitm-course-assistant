# Optional but recommended for semantic embeddings and AI-generated answers.
# Create a Hugging Face token with Inference Providers permission and keep it server-side.
HF_TOKEN=

# Defaults shown. You can change these models if your account/provider supports other models.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CHAT_MODEL=openai/gpt-oss-20b:fastest
