# Groq is the preferred provider when both provider keys are set.
# Create a key in the Groq console and keep it server-side (do not use NEXT_PUBLIC_).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Optional Hugging Face fallback. Used only when GROQ_API_KEY is not set.
# HF mode adds semantic embeddings; create a fine-grained token with Inference Providers permission.
HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CHAT_MODEL=openai/gpt-oss-20b:fastest
